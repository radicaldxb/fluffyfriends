# Supabase (from project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n (e.g. workflow webhook URL or instance URL + API key)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-workflow-id
# Optional: if using n8n API
# N8N_BASE_URL=https://your-n8n-instance.com
# N8N_API_KEY=your-n8n-api-key
