# Copy this file to .env.local for local development. Next.js loads .env.local automatically.
# Supabase (from project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n: set in Netlify env. Test on the deployed site (e.g. your-site.netlify.app/create).
# Main webhook for /create and full flow (use production URL).
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/transform-pet

# n8n – post-payment upscaler + email (Workflow 3 — Upscale + Email)
# When set, /api/approve-portrait will POST approved portraits here.
# Default in code falls back to https://n8n.srv943460.hstgr.cloud/webhook/upscale-and-email
# if this variable is not configured.
# N8N_UPSCALE_AND_EMAIL_WEBHOOK_URL=https://your-n8n-instance.com/webhook/upscale-and-email

# Optional but recommended: secret for n8n callback (receive-n8n-image). When set, n8n must send
# this value in header X-Webhook-Secret (or Authorization: Bearer <secret>) or the callback is rejected.
# N8N_WEBHOOK_SECRET=your-random-secret-string

# Optional: URL for "Ping webhook" on /test-n8n. If set, Ping uses this; else uses N8N_WEBHOOK_URL.
# Set to test-production-url or diagnostic-ping workflow so you don't have to swap URLs.
# N8N_PING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/test-production-url

# Optional: Google Gemini API key for subject validation. When set, /api/create-portrait checks each
# image for exactly one pet (no group photos, humans, or objects) before uploading or calling n8n.
# Same key can be used in n8n for the portrait-generation GEMINI node.
# GEMINI_API_KEY=your-google-ai-api-key
