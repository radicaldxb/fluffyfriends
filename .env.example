# Supabase (from project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n: set in Netlify env. Test on the deployed site (e.g. your-site.netlify.app/create).
# Main webhook for /create and full flow (use production URL).
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/transform-pet

# Optional: URL for "Ping webhook" on /test-n8n. If set, Ping uses this; else uses N8N_WEBHOOK_URL.
# Set to test-production-url or diagnostic-ping workflow so you don't have to swap URLs.
# N8N_PING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/test-production-url
